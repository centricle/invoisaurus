{
  "name": "invoisaurus",
  "version": "2.1.0",
  "description": "Invoice generator. Web UI in, PDF out. Runs locally on JSON files, or as a package inside a host of your own.",
  "license": "AGPL-3.0-only",
  "author": "Kevin Smith <ksmith@centricle.com> (https://centricle.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/centricle/invoisaurus.git"
  },
  "keywords": [
    "invoice",
    "invoicing",
    "pdf",
    "pdf-lib",
    "express",
    "self-hosted",
    "local-first",
    "open-core"
  ],
  "type": "module",
  "main": "./src/app.js",
  "exports": {
    ".": "./src/app.js",
    "./store": "./src/store.js",
    "./storage": "./src/storage.js",
    "./memory": "./src/storage-memory.js",
    "./schema": "./src/schema.js",
    "./money": "./src/money.js",
    "./markup": "./src/lib/markup.js",
    "./import": "./src/import.js",
    "./pdf": "./src/lib/pdf/generate.js",
    "./fonts": "./src/lib/pdf/fonts.js",
    "./demo": "./src/demo.js",
    "./seed": "./src/seed.js",
    "./fixtures": "./src/fixtures/acme.js",
    "./csrf": "./src/csrf.js",
    "./cookies": "./src/cookies.js",
    "./flash": "./src/flash.js",
    "./paths": "./src/paths.js",
    "./testing": "./test/store-contract.js",
    "./package.json": "./package.json"
  },
  "files": [
    "server.js",
    "src/",
    "public/",
    "!public/css/dist/",
    "scripts/",
    "netlify/",
    "netlify.toml",
    "test/store-contract.js",
    "test/store-contract.golden.json"
  ],
  "scripts": {
    "setup": "sh scripts/bootstrap.sh",
    "dev": "concurrently -n css,web -c magenta,green \"npm:css\" \"node --watch server.js\"",
    "demo": "npm run css:build && node scripts/demo.mjs",
    "start": "npm run css:build && node server.js",
    "build": "npm run css:build && node scripts/build-static.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "smoke:bundle": "node scripts/smoke-bundle.mjs",
    "css": "npx @tailwindcss/cli -i public/css/app.css -o public/css/dist/app.css --watch",
    "css:build": "npx @tailwindcss/cli -i public/css/app.css -o public/css/dist/app.css --minify",
    "seed": "node scripts/seed.mjs",
    "import": "node scripts/import.mjs",
    "data:commit": "node scripts/data-commit.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
