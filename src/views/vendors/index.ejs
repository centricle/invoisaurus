<%- include('../partials/layout-head', { title: 'Vendors' }) %>

<div class="mb-2 flex items-end justify-between">
  <h1 class="text-2xl font-display font-medium tracking-tight text-ink">Vendors</h1>
  <a href="<%= u('/vendors/new') %>" class="btn btn-primary">New Vendor</a>
</div>
<p class="mb-8 text-sm text-faint">The entities that issue invoices. Each keeps its own number series.</p>

<% if (!vendors.length) { %>
  <div class="rounded-lg border border-dashed border-rule px-6 py-16 text-center">
    <p class="text-sm text-muted">No vendors yet.</p>
  </div>
<% } else { %>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="border-b border-rule text-left text-xs uppercase tracking-wide text-faint">
      <tr>
        <th class="py-2 font-medium">Company</th>
        <th class="py-2 font-medium">Email</th>
        <th class="py-2 font-medium">Location</th>
        <th class="py-2 text-right font-medium">Next number</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule/60">
      <% vendors.forEach((v) => { %>
        <tr class="hover:bg-ink/5">
          <td class="py-3"><a href="<%= u('/vendors/' + (v.id) + '/edit') %>" class="text-accent hover:underline"><%= v.name %></a></td>
          <td class="py-3 text-muted"><%= v.email || '—' %></td>
          <td class="py-3 text-muted"><%= [v.address.city, v.address.state].filter(Boolean).join(', ') || '—' %></td>
          <td class="py-3 text-right font-mono text-muted"><%= formatInvoiceNumber(v, v.nextNumber) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/layout-foot') %>
