  </main>
  <script src="<%= u('/js/stepper.js') %>" defer></script>
  <script src="<%= u('/js/hint.js') %>" defer></script>
  <script src="<%= u('/js/unsaved.js') %>" defer></script>
  <script src="<%= u('/js/theme.js') %>" defer></script>
  <footer class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 pb-10 text-xs text-muted/60">
    <div>
      <% if (locals.footer) { %>
        <% if (footer.mono) { %>
          <span class="font-mono"><%= footer.text %></span>
        <% } else { %>
          <%= footer.text %>
        <% } %>
        <% if (footer.link) { %>
          <a href="<%= footer.link.href %>" class="text-faint underline hover:text-ink/80"><%= footer.link.label %></a>
        <% } %>
        <% if (footer.tail) { %><%= footer.tail %><% } %>
        <% (footer.links || []).forEach((link) => { %>
          <a href="<%= link.href %>" class="ml-3 text-muted/60 hover:text-ink"><%= link.label %></a>
        <% }) %>
      <% } %>
    </div>
    <%- include('theme-control', { theme: locals.theme, cookiePath: locals.cookiePath }) %>
  </footer>
</body>
</html>
