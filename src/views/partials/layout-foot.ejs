  </main>
  <%# Light/dark switch, fixed to the bottom right of the viewport. Last in
      tab order on purpose. public/js/theme.js drives it: aria-checked="true"
      means the light theme is showing. %>
  <button type="button" role="switch" aria-checked="<%= locals.theme === 'light' ? 'true' : 'false' %>"
          aria-label="Light theme" data-theme-toggle data-cookie-path="<%= locals.cookiePath || '/' %>"
          class="theme-switch">
    <span class="theme-switch-track">
      <span class="theme-switch-knob">
        <svg class="theme-switch-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
        </svg>
        <svg class="theme-switch-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
          <path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
        </svg>
      </span>
    </span>
  </button>
  <script src="<%= u('/js/stepper.js') %>" defer></script>
  <script src="<%= u('/js/hint.js') %>" defer></script>
  <script src="<%= u('/js/unsaved.js') %>" defer></script>
  <script src="<%= u('/js/theme.js') %>" defer></script>
  <footer class="mx-auto max-w-5xl px-6 pb-10 text-xs text-slate-600">
    <% if (locals.footer) { %>
      <% if (footer.mono) { %>
        <span class="font-mono"><%= footer.text %></span>
      <% } else { %>
        <%= footer.text %>
      <% } %>
      <% if (footer.link) { %>
        <a href="<%= footer.link.href %>" class="text-slate-500 underline hover:text-slate-300"><%= footer.link.label %></a>
      <% } %>
      <% if (footer.tail) { %><%= footer.tail %><% } %>
    <% } %>
  </footer>
</body>
</html>
