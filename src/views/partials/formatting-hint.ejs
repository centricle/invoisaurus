<%#
  A help button that opens the formatting cheat sheet in a popover.

  A popover rather than a tooltip, and a click rather than a hover: the sheet is
  six rows a reader will want to look at while typing, and a hover card is gone
  the moment the pointer leaves for the field. The native Popover API gives
  light dismiss, Escape and the invoker's expanded state without any script; the
  only script is placement, in public/js/hint.js, because a top-layer element
  cannot be positioned by an ancestor.

  Takes `id`. Two fields share the sheet on one page, and a popover id must be
  unique, so each caller passes its own.
%>
<button type="button" popovertarget="<%= id %>" aria-label="Formatting help"
        class="inline-flex text-slate-500 hover:text-slate-200 focus:text-slate-200 focus:outline-none">
  <svg viewBox="0 0 20 20" aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor"
       stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="10" cy="10" r="7.25" />
    <path d="M7.75 8a2.25 2.25 0 1 1 3.2 2.05c-.6.3-.95.7-.95 1.35v.35" />
    <path d="M10 14.25h.01" />
  </svg>
</button>
<div id="<%= id %>" popover class="hint-popover">
  <p class="mb-2 text-[0.625rem] font-semibold uppercase tracking-widest text-slate-500">Formatting</p>
  <table class="w-full">
    <tbody>
      <tr><td><code>**bold**</code></td><td><strong class="text-slate-100">bold</strong></td></tr>
      <tr><td><code>*italic*</code></td><td><em>italic</em></td></tr>
      <tr><td><code># Heading</code></td><td><strong class="text-[0.875rem] text-slate-100">Heading</strong></td></tr>
      <tr><td><code>- item</code></td><td>&bull; bulleted list</td></tr>
      <tr><td><code>1. item</code></td><td>1. numbered list</td></tr>
      <tr><td><code>\*</code></td><td>a literal *</td></tr>
    </tbody>
  </table>
  <p class="mt-2 text-slate-500">
    Every line break prints. Everything else prints as you typed it.
  </p>
</div>
