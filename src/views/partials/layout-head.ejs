<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Invoisaurus</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Ctext y=%2713%27 font-size=%2713%27%3E%F0%9F%A7%BE%3C/text%3E%3C/svg%3E">
  <link rel="stylesheet" href="/css/dist/app.css">
</head>
<body class="h-full bg-slate-950 text-slate-200 antialiased">
  <header class="border-b border-slate-800">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="text-sm font-semibold tracking-tight text-slate-100">Invoisaurus</a>
      <nav class="flex gap-5 text-sm text-slate-400">
        <a href="/" class="hover:text-slate-100">Invoices</a>
        <a href="/clients" class="hover:text-slate-100">Clients</a>
        <a href="/vendors" class="hover:text-slate-100">Vendors</a>
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-6 py-10">
    <% if (locals.flash) { %>
      <p role="status"
         class="mb-6 rounded-md border border-emerald-900/60 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-300">
        <%= flash %>
      </p>
    <% } %>
