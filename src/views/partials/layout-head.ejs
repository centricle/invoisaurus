<!doctype html>
<html lang="en" class="h-full">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Invoisaurus</title>
  <link rel="icon" href="<%= u('/favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= u('/css/dist/app.css') %>">
</head>
<body class="h-full bg-slate-950 text-slate-200 antialiased">
  <%
    // The chrome has slots, not modes. Whatever attached the request's store
    // fills them -- the demo says "this is a demo", a host says who is signed
    // in -- and the layout renders what it is given. A partial cannot be
    // overridden by whoever includes it, so this is the only way a host gets
    // its own words up here without a copy of the file.
    //   banner:   { strong, text, action: { href, label } }   action posts, app-relative
    //   badge:    text beside the wordmark
    //   navRight: [{ href, label, method }]                 method 'post' renders a button
    //   footer:   { text, mono, link: { href, label }, tail }
  %>
  <% if (locals.banner) { %>
    <div class="border-b border-amber-900/60 bg-amber-950/40 text-amber-300">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-2.5 text-sm">
        <p>
          <% if (banner.strong) { %><strong class="font-medium"><%= banner.strong %></strong><% } %>
          <%= banner.text %>
        </p>
        <% if (banner.action) { %>
          <form method="post" action="<%= u(banner.action.href) %>">
            <button type="submit"
                    class="rounded border border-amber-800/70 px-2 py-1 text-xs text-amber-200 hover:bg-amber-900/40">
              <%= banner.action.label %>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>
  <header class="border-b border-slate-800">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="<%= u('/') %>" class="flex items-center gap-2 text-sm font-semibold tracking-tight text-slate-100">
        <!-- Inlined rather than <img src="<%= u('/favicon.svg') %>">, so the mark inherits
             currentColor and sizes in rem alongside the root scale. -->
        <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 14h6" /><path d="M4 2h10" />
          <rect x="4" y="18" width="16" height="4" rx="1" /><rect x="4" y="6" width="16" height="4" rx="1" />
        </svg>
        Invoisaurus
        <% if (locals.badge) { %>
          <span class="rounded bg-amber-900/60 px-1.5 py-0.5 text-[0.625rem] font-semibold uppercase tracking-wide text-amber-300"><%= badge %></span>
        <% } %>
      </a>
      <nav class="flex items-center gap-5 text-sm">
        <%
          const section = (locals.currentPath || '/').split('/')[1] || 'invoices';
          const navItems = [['invoices', 'Invoices'], ['clients', 'Clients'], ['vendors', 'Vendors']];
        %>
        <% navItems.forEach(([href, label]) => { %>
          <a href="<%= u('/' + (href)) %>"
             class="<%= section === href ? 'text-slate-100 font-medium' : 'text-slate-400 hover:text-slate-100' %>"
             <%- section === href ? 'aria-current="page"' : '' %>><%= label %></a>
        <% }) %>
        <% (locals.navRight || []).forEach((item) => { %>
          <% if (item.method === 'post') { %>
            <form method="post" action="<%= u(item.href) %>">
              <button type="submit" class="text-slate-400 hover:text-slate-100"><%= item.label %></button>
            </form>
          <% } else { %>
            <a href="<%= u(item.href) %>" class="text-slate-400 hover:text-slate-100"><%= item.label %></a>
          <% } %>
        <% }) %>
      </nav>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-6 py-10">
    <% if (locals.flash) { %>
      <p role="status"
         class="mb-6 rounded-md border border-emerald-900/60 bg-emerald-950/40 px-4 py-3 text-sm text-emerald-300">
        <%= flash %>
      </p>
    <% } %>
