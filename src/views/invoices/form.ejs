<% const termDays = Object.fromEntries(TERMS.map((t) => [t.id, t.days])); %>
<%- include('../partials/layout-head', { title: isNew ? 'New Invoice' : invoice.id }) %>

<div class="mb-8 flex items-start justify-between">
  <div>
    <%
      // Badges align to the top of the number rather than its baseline, so the
      // number stays the thing you read first and the status rides above it.
      const badge = 'rounded-full border px-2 py-0.5 text-[0.625rem] font-semibold uppercase tracking-widest';
    %>
    <h1 class="flex items-start gap-2 text-2xl font-semibold tracking-tight text-slate-100">
      <%= isNew ? 'New Invoice' : invoice.id %>
      <% if (!isNew) { %>
        <span class="mt-1 <%= badge %> <%= statusBadgeClass(invoice.status) %>"><%= invoice.status %></span>
        <% if (isOverdue(invoice)) { %>
          <span class="mt-1 <%= badge %> border-amber-800 bg-amber-950/70 text-amber-300">
            <%= daysOverdue(invoice) %>d late
          </span>
        <% } %>
      <% } %>
    </h1>
    <p class="mt-1 text-sm text-slate-500">
      <%= invoice.billTo ? invoice.billTo.name : 'Unknown client' %>
    </p>
  </div>
  <% if (!isNew) { %>
    <div class="flex items-center gap-3">
      <a href="<%= u('/invoices/' + (invoice.id) + '/pdf?download=1') %>"
         class="inline-flex items-center gap-2 rounded-md border border-slate-700 px-3 py-2 text-sm text-slate-200 hover:border-slate-500">
        Download PDF
        <svg viewBox="0 0 20 20" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 3v9" /><path d="M6.5 8.5 10 12l3.5-3.5" /><path d="M4 14.5v1A1.5 1.5 0 0 0 5.5 17h9a1.5 1.5 0 0 0 1.5-1.5v-1" />
        </svg>
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/errors') %>

<form method="post" id="invoice-form" data-invoice-form
      data-term-days='<%- JSON.stringify(termDays) %>'
      action="<%= u(isNew ? '/invoices' : `/invoices/${invoice.id}`) %>" class="space-y-8">
  <%- locals.csrfField?.() ?? '' %>

  <input type="hidden" name="clientId" value="<%= invoice.clientId %>">

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
    <label class="block">
      <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">Issued by</span>
      <%# The vendor is choosable only while the invoice is being created. Its
          number already came out of this vendor's series and its remit-from
          block is already snapshotted, so switching it afterward would leave
          the document and the record describing different companies. The
          server ignores a submitted vendorId on an existing invoice; this
          keeps the page from offering a control that does nothing. %>
      <% if (isNew) { %>
        <select name="vendorId" class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
          <% vendors.forEach((v) => { %>
            <option value="<%= v.id %>" <%= invoice.vendorId === v.id ? 'selected' : '' %>><%= v.name %></option>
          <% }) %>
        </select>
      <% } else { %>
        <p class="rounded-md border border-slate-800/60 bg-slate-900/40 px-3 py-2 text-sm text-slate-400">
          <%= (vendors.find((v) => v.id === invoice.vendorId) || {}).name || invoice.vendorId %>
        </p>
      <% } %>
    </label>
    <%- field('issueDate', 'Invoice date', invoice.issueDate, { type: 'date' }) %>
    <label class="block">
      <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">Terms</span>
      <select name="terms" class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
        <% TERMS.forEach((t) => { %>
          <option value="<%= t.id %>" <%= invoice.terms === t.id ? 'selected' : '' %>><%= t.label %></option>
        <% }) %>
      </select>
    </label>
    <label class="block">
      <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">Payment due</span>
      <input type="date" name="dueDate" value="<%= invoice.dueDate %>"
             data-overridden="<%= invoice.dueDate !== dueDateFor(invoice.issueDate, invoice.terms) %>"
             class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
      <p class="mt-1 text-xs text-slate-500">Follows terms until you change it.</p>
    </label>
  </div>

  <div>
    <table class="w-full text-sm">
      <thead class="border-b border-slate-800 text-left text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="py-2 font-medium">
            <span class="inline-flex items-center gap-1.5">
              Description
              <%- include('../partials/formatting-hint', { id: 'hint-description' }) %>
            </span>
          </th>
          <th class="w-28 py-2 font-medium">Qty</th>
          <th class="w-32 py-2 font-medium">Rate</th>
          <th class="w-32 py-2 text-right font-medium">Amount</th>
          <th class="w-10 py-2"></th>
        </tr>
      </thead>
      <tbody data-line-items class="divide-y divide-slate-900">
        <% invoice.lineItems.forEach((li, i) => { %>
          <tr data-line-item>
            <td class="py-2 pr-3">
              <textarea name="description[]" rows="1" data-autogrow
                        class="w-full resize-none rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none"><%= li.description %></textarea>
            </td>
            <td class="py-2 pr-3">
              <input name="quantity[]" type="number" step="any" min="0" inputmode="decimal" data-stepper data-step-amount="0.25" value="<%= quantityInputValue(li.quantityMilli) %>"
                     class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-right text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
            </td>
            <td class="py-2 pr-3">
              <input type="text" name="rate[]" inputmode="decimal" value="<%= centsInputValue(li.rateCents) %>"
                     class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-right text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
            </td>
            <td class="py-2 text-right font-mono text-slate-300" data-amount>
              <%= totals.amounts[i] ? formatUSD(totals.amounts[i]) : '—' %>
            </td>
            <td class="py-2 text-right">
              <button type="button" data-remove title="Remove line" aria-label="Remove line item"
                      class="rounded px-2 py-1 text-slate-600 hover:text-red-400 disabled:opacity-30 disabled:hover:text-slate-600">&times;</button>
            </td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" class="pt-4">
            <button type="button" data-add-row
                    class="rounded-md border border-slate-700 px-3 py-1.5 text-sm text-slate-300 hover:border-slate-500">
              Add line
            </button>
          </td>
          <td class="pt-4 text-right">
            <div class="text-xs uppercase tracking-wide text-slate-500">Amount due</div>
            <div class="font-mono text-lg text-slate-100" data-total><%= formatUSD(totals.totalCents) %></div>
          </td>
          <td></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <%# Not a wrapping <label>: a button is a labelable element, so a help button
      inside one would become the label's control instead of the textarea. %>
  <div class="max-w-2xl">
    <div class="mb-1 flex items-center gap-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">
      <label for="notes">Notes</label>
      <%- include('../partials/formatting-hint', { id: 'hint-notes' }) %>
    </div>
    <textarea id="notes" name="notes" rows="3" data-autogrow
              class="w-full resize-none rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none"><%= invoice.notes %></textarea>
    <p class="mt-1 text-xs text-slate-500">Optional. Prints at the bottom of the invoice.</p>
  </div>

  <div class="flex items-center gap-3 border-t border-slate-900 pt-6">
    <button type="submit" class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-500">
      <%= isNew ? 'Create Invoice' : 'Save Changes' %>
    </button>
    <a href="<%= u('/invoices') %>" class="text-sm text-slate-400 hover:text-slate-200">Cancel</a>
    <% if (!isNew) { %>
      <span class="flex-1"></span>
      <label class="text-xs uppercase tracking-wide text-slate-500">
        Status
        <select name="status" class="ml-2 rounded-md border border-slate-800 bg-slate-900 px-2 py-1 text-xs text-slate-200 focus:border-sky-600 focus:outline-none">
          <% INVOICE_STATUSES.forEach((s) => { %>
            <option value="<%= s %>" <%= invoice.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </label>
    <% } %>
  </div>
</form>

<% if (!isNew) { %>
  <%# The id is carried as data and never interpolated into a script. EJS
      escapes for HTML, but the browser decodes those entities back before the
      JS parser runs, so a quote in an id would close a string literal in an
      inline handler and the form would submit with no confirmation at all.
      Validation keeps quotes out of ids; this keeps the page correct without
      relying on it. invoice-editor.js binds the handler. %>
  <form method="post" action="<%= u('/invoices/' + (invoice.id) + '/delete') %>" class="mt-10"
        data-delete-invoice="<%= invoice.id %>">
    <%- locals.csrfField?.() ?? '' %>
    <button type="submit"
            class="inline-flex items-center gap-1.5 text-xs text-slate-600 hover:text-red-400">
      <svg viewBox="0 0 20 20" aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor"
           stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3.5 5.5h13" />
        <path d="M8 5.5V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5" />
        <path d="M5.5 5.5v10A1.5 1.5 0 0 0 7 17h6a1.5 1.5 0 0 0 1.5-1.5v-10" />
        <path d="M8.5 8.5v5" /><path d="M11.5 8.5v5" />
      </svg>
      Delete this invoice
    </button>
  </form>
<% } %>


<template id="line-item-template">
  <tr data-line-item>
    <td class="py-2 pr-3">
      <textarea name="description[]" rows="1" data-autogrow
                class="w-full resize-none rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none"></textarea>
    </td>
    <td class="py-2 pr-3">
      <input name="quantity[]" type="number" step="any" min="0" inputmode="decimal" data-stepper data-step-amount="0.25"
             class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-right text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
    </td>
    <td class="py-2 pr-3">
      <input type="text" name="rate[]" inputmode="decimal"
             class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-right text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
    </td>
    <td class="py-2 text-right font-mono text-slate-300" data-amount>—</td>
    <td class="py-2 text-right">
      <button type="button" data-remove title="Remove line" aria-label="Remove line item"
              class="rounded px-2 py-1 text-slate-600 hover:text-red-400 disabled:opacity-30 disabled:hover:text-slate-600">&times;</button>
    </td>
  </tr>
</template>


<% if (!isNew) { %>
  <section class="mt-12">
    <div class="mb-3 flex items-center justify-between">
      <%- include('../partials/style-toggle', {
        styles: INVOICE_STYLES,
        current: currentStyle,
        frozen: invoice.status !== 'draft',
        form: 'invoice-form',
      }) %>
      <a href="<%= u('/invoices/' + (invoice.id) + '/pdf') %>" target="_blank" rel="noopener"
         title="Open the PDF in a new tab" aria-label="Open the PDF in a new tab"
         class="rounded p-1.5 text-slate-500 hover:text-slate-200">
        <svg viewBox="0 0 20 20" aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11.5 4H16v4.5" /><path d="M16 4l-6.5 6.5" />
          <path d="M15 12.5v3A1.5 1.5 0 0 1 13.5 17h-9A1.5 1.5 0 0 1 3 15.5v-9A1.5 1.5 0 0 1 4.5 5h3" />
        </svg>
      </a>
    </div>
    <!-- The preview is the real PDF, not a second HTML rendering of the same
         data. There is nothing here that can drift from what the client gets. -->
    <iframe src="<%= u('/invoices/' + (invoice.id) + '/pdf#toolbar=0') %>" title="Invoice <%= invoice.id %>"
            class="h-[56.25rem] w-full rounded-lg border border-slate-800 bg-slate-900"></iframe>
  </section>
<% } %>

<script src="<%= u('/js/invoice-editor.js') %>"></script>

<%- include('../partials/layout-foot') %>
