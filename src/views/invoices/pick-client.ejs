<%- include('../partials/layout-head', { title: 'New Invoice' }) %>

<h1 class="mb-2 text-2xl font-semibold tracking-tight text-slate-100">New Invoice</h1>
<p class="mb-8 text-sm text-slate-500">Choose who this is for.</p>

<% if (!clients.length) { %>
  <div class="rounded-lg border border-dashed border-slate-800 px-6 py-16 text-center">
    <p class="text-sm text-slate-400">No clients yet.</p>
    <a href="/clients/new" class="mt-3 inline-block text-sm text-sky-400 hover:underline">Add a client</a>
  </div>
<% } else { %>
  <form method="get" action="/invoices/new" class="max-w-lg space-y-5">
    <label class="block">
      <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">Client</span>
      <select name="clientId" required class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
        <% clients.forEach((c) => { %><option value="<%= c.id %>"><%= clientLabel(c) %></option><% }) %>
      </select>
    </label>

    <% if (vendors.length > 1) { %>
      <label class="block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-slate-400">Issued by</span>
        <select name="vendorId" class="w-full rounded-md border border-slate-800 bg-slate-900 px-3 py-2 text-sm text-slate-100 focus:border-sky-600 focus:outline-none">
          <% vendors.forEach((v) => { %><option value="<%= v.id %>"><%= v.name %></option><% }) %>
        </select>
      </label>
    <% } %>

    <div class="flex items-center gap-3">
      <button type="submit" class="rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-500">Continue</button>
      <a href="/invoices" class="text-sm text-slate-400 hover:text-slate-200">Cancel</a>
    </div>
  </form>
<% } %>

<%- include('../partials/layout-foot') %>
