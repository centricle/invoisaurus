<%- include('../partials/layout-head', { title: 'New Invoice' }) %>

<h1 class="mb-2 text-2xl font-display font-medium tracking-tight text-ink">New Invoice</h1>
<p class="mb-8 text-sm text-faint">Choose who this is for.</p>

<%# An invoice needs both an issuing entity and someone to bill. The vendor is
    asked for first because it is the one that carries the number series, so
    nothing can be issued without it. %>
<% if (!vendors.length) { %>
  <div class="rounded-lg border border-dashed border-rule px-6 py-16 text-center">
    <p class="text-sm text-muted">No vendors yet.</p>
    <p class="mt-1 text-xs text-faint">A vendor is the entity that issues the invoice and owns its number series.</p>
    <a href="<%= u('/vendors/new') %>" class="mt-3 inline-block text-sm text-accent hover:underline">Add a vendor</a>
  </div>
<% } else if (!clients.length) { %>
  <div class="rounded-lg border border-dashed border-rule px-6 py-16 text-center">
    <p class="text-sm text-muted">No clients yet.</p>
    <a href="<%= u('/clients/new') %>" class="mt-3 inline-block text-sm text-accent hover:underline">Add a client</a>
  </div>
<% } else { %>
  <form method="get" action="<%= u('/invoices/new') %>" class="max-w-lg space-y-5">
    <label class="block">
      <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-muted">Client</span>
      <select name="clientId" required class="field w-full">
        <% clients.forEach((c) => { %><option value="<%= c.id %>"><%= clientLabel(c) %></option><% }) %>
      </select>
    </label>

    <% if (vendors.length > 1) { %>
      <label class="block">
        <span class="mb-1 block text-xs font-medium uppercase tracking-wide text-muted">Issued by</span>
        <select name="vendorId" class="field w-full">
          <% vendors.forEach((v) => { %><option value="<%= v.id %>"><%= v.name %></option><% }) %>
        </select>
      </label>
    <% } %>

    <div class="flex items-center gap-3">
      <button type="submit" class="btn btn-primary">Continue</button>
      <a href="<%= u('/invoices') %>" class="text-sm text-muted hover:text-ink">Cancel</a>
    </div>
  </form>
<% } %>

<%- include('../partials/layout-foot') %>
