<%- include('../partials/layout-head', { title: 'Clients' }) %>

<div class="mb-8 flex items-end justify-between">
  <h1 class="text-2xl font-display font-medium tracking-tight text-ink">Clients</h1>
  <a href="<%= u('/clients/new') %>" class="btn btn-primary">New Client</a>
</div>

<% if (!clients.length) { %>
  <div class="rounded-lg border border-dashed border-rule px-6 py-16 text-center">
    <p class="text-sm text-muted">No clients yet.</p>
  </div>
<% } else { %>
  <div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="border-b border-rule text-left text-xs uppercase tracking-wide text-faint">
      <tr>
        <th class="py-2 font-medium">Client</th>
        <th class="py-2 font-medium">Legal name</th>
        <th class="py-2 font-medium">Attn</th>
        <th class="py-2 font-medium">Type</th>
        <th class="py-2 text-right font-medium">Invoices</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-rule/60">
      <% clients.forEach((c) => { %>
        <tr class="hover:bg-ink/5">
          <td class="py-3">
            <a href="<%= u('/clients/' + (c.id) + '/edit') %>" class="text-accent hover:underline"><%= clientLabel(c) %></a>
          </td>
          <td class="py-3 text-muted"><%= c.name %></td>
          <td class="py-3 text-muted"><%= c.contactName || '—' %></td>
          <td class="py-3 text-muted"><%= c.type %></td>
          <td class="py-3 text-right font-mono text-muted"><%= c.invoiceCount %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
<% } %>

<%- include('../partials/layout-foot') %>
