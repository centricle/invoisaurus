<%- include('partials/layout-head', { title: 'Not saved' }) %>
<div class="rounded-lg border border-dashed border-warn/30 px-6 py-16 text-center">
  <h1 class="font-display text-xl font-medium tracking-tight text-ink">Nothing was saved.</h1>
  <%# `why` is one of cross-site, origin, token. The visitor does not need the
      taxonomy; the fix is the same for all three. %>
  <p class="mt-2 text-sm text-muted">
    That form could not be verified as coming from this site. Go back, reload the page
    and try again. This happens when a page was left open for a long time, or
    was submitted from somewhere other than this site.
  </p>
  <a href="<%= u('/') %>" class="btn btn-quiet mt-4">Back to invoices</a>
</div>
<%- include('partials/layout-foot') %>
